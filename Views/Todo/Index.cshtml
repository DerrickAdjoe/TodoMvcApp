@model IEnumerable<TodoMvcApp.Models.TodoItem>

@{
    ViewData["Title"] = "My To-Do List";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <ul class="list-group my-3">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                    @item.Title
                </span>
                <span class="badge @(item.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                    @(item.IsCompleted ? "Done" : "Pending")
                </span>
            </li>
        }
    </ul>
</div>